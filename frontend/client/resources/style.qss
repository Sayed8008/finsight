/* FinSight — application stylesheet.
 *
 * A restrained, neutral palette. Colour is used to carry meaning (status,
 * selection) rather than for decoration, so that later on green/amber/red can
 * mean "healthy / warning / exceeded" without competing with the interface.
 */

/* ─── Base ──────────────────────────────────────────────────────────────── */

QWidget {
    background-color: #f7f8fa;
    color: #1c2024;
    font-family: "Inter", "Segoe UI", "Ubuntu", "DejaVu Sans", sans-serif;
    font-size: 14px;
}

#ContentArea {
    background-color: #f7f8fa;
}

/* ─── Sidebar ───────────────────────────────────────────────────────────── */

#Sidebar {
    background-color: #ffffff;
    border-right: 1px solid #e3e6ea;
}

#Wordmark {
    padding: 22px 20px 18px 20px;
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.2px;
    color: #0f1419;
    background-color: transparent;
}

#NavList {
    background-color: transparent;
    outline: none;
    padding: 4px 10px;
}

#NavList::item {
    padding: 10px 12px;
    margin: 1px 0;
    border-radius: 6px;
    color: #4a5259;
}

#NavList::item:hover {
    background-color: #f0f2f5;
    color: #1c2024;
}

#NavList::item:selected {
    background-color: #eaf1fd;
    color: #1a56c4;
    font-weight: 600;
}

/* ─── Backend status indicator ──────────────────────────────────────────── */

#SidebarStatus {
    padding: 12px 20px;
    font-size: 12px;
    border-top: 1px solid #e3e6ea;
    background-color: transparent;
    color: #6b7480;
}

#SidebarStatus[online="true"] {
    color: #1a7f4b;
}

#SidebarStatus[online="false"] {
    color: #b4232c;
}

/* ─── Placeholder / empty states ────────────────────────────────────────── */

#PlaceholderView {
    background-color: #f7f8fa;
}

#PlaceholderTitle {
    font-size: 20px;
    font-weight: 600;
    color: #1c2024;
    background-color: transparent;
}

/* Wrap width is set in placeholder.py — Qt stylesheets have no max-width. */
#PlaceholderMessage {
    font-size: 14px;
    color: #6b7480;
    background-color: transparent;
}

/* ─── Account panel ─────────────────────────────────────────────────────── */

#AccountPanel {
    border-top: 1px solid #e3e6ea;
    background-color: transparent;
}

#AccountName {
    font-size: 13px;
    font-weight: 600;
    color: #1c2024;
    background-color: transparent;
}

#AccountEmail {
    font-size: 12px;
    color: #6b7480;
    background-color: transparent;
}

/* ─── Authentication screen ─────────────────────────────────────────────── */

#AuthView {
    background-color: #f7f8fa;
}

#AuthCard {
    background-color: #ffffff;
    border: 1px solid #e3e6ea;
    border-radius: 10px;
}

#AuthTitle {
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.2px;
    color: #0f1419;
    background-color: transparent;
}

#AuthSubtitle {
    font-size: 13px;
    color: #6b7480;
    background-color: transparent;
}

#AuthSwitchRow {
    background-color: transparent;
}

#AuthSwitchPrompt {
    font-size: 13px;
    color: #6b7480;
    background-color: transparent;
}

/* ─── Form controls ─────────────────────────────────────────────────────── */

#FieldLabel {
    font-size: 13px;
    font-weight: 500;
    color: #4a5259;
    background-color: transparent;
}

#FieldInput {
    padding: 9px 11px;
    border: 1px solid #cdd2d9;
    border-radius: 6px;
    background-color: #ffffff;
    color: #1c2024;
    selection-background-color: #1a56c4;
    selection-color: #ffffff;
}

#FieldInput:focus {
    border-color: #1a56c4;
}

#FieldInput:disabled {
    background-color: #f0f2f5;
    color: #8b939c;
}

#PrimaryButton {
    padding: 10px 16px;
    border: none;
    border-radius: 6px;
    background-color: #1a56c4;
    color: #ffffff;
    font-size: 14px;
    font-weight: 600;
}

#PrimaryButton:hover {
    background-color: #164aa8;
}

#PrimaryButton:pressed {
    background-color: #133e8c;
}

#PrimaryButton:disabled {
    background-color: #a9bee6;
    color: #eef2fb;
}

#LinkButton {
    border: none;
    background: transparent;
    color: #1a56c4;
    font-size: 13px;
    font-weight: 600;
    padding: 0;
    text-align: left;
}

#LinkButton:hover {
    color: #133e8c;
}

/* ─── Inline messages ───────────────────────────────────────────────────── */

#MessageBanner {
    padding: 9px 11px;
    border-radius: 6px;
    font-size: 13px;
}

#MessageBanner[level="error"] {
    background-color: #fdeceb;
    border: 1px solid #f3c4c0;
    color: #9c1f19;
}

#MessageBanner[level="info"] {
    background-color: #eaf1fd;
    border: 1px solid #c3d6f6;
    color: #16428f;
}

/* ─── Section headings ──────────────────────────────────────────────────── */

#SectionTitle {
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.2px;
    color: #0f1419;
    background-color: transparent;
}

#SectionSubtitle,
#PagerLabel {
    font-size: 13px;
    color: #6b7480;
    background-color: transparent;
}

/* ─── Filter bar ────────────────────────────────────────────────────────── */

#FilterBar {
    background-color: #ffffff;
    border: 1px solid #e3e6ea;
    border-radius: 8px;
}

/* The container a LabelledWidget provides. Transparent by *id*, deliberately,
 * rather than with a descendant rule such as `#FilterBar QWidget`: a QPushButton
 * is a QWidget, so that rule would also match the buttons inside — and since
 * `#FilterBar QWidget` is more specific than `#PrimaryButton`, it would win and
 * paint the primary button in nothing at all (ADR-022). */
#FormRow {
    background-color: transparent;
}

/* Combo boxes and date editors. Kept visually identical to #FieldInput so a
 * form row does not look assembled from parts. */
#FieldSelect {
    padding: 8px 10px;
    border: 1px solid #cdd2d9;
    border-radius: 6px;
    background-color: #ffffff;
    color: #1c2024;
    min-height: 18px;
}

#FieldSelect:focus,
#FieldSelect:on {
    border-color: #1a56c4;
}

#FieldSelect::drop-down {
    border: none;
    width: 18px;
}

#FieldSelect QAbstractItemView {
    border: 1px solid #cdd2d9;
    background-color: #ffffff;
    selection-background-color: #eaf1fd;
    selection-color: #1a56c4;
    outline: none;
}

/* ─── Buttons beyond the primary one ────────────────────────────────────── */

#SecondaryButton {
    padding: 8px 14px;
    border: 1px solid #cdd2d9;
    border-radius: 6px;
    background-color: #ffffff;
    color: #1c2024;
    font-size: 13px;
    font-weight: 500;
}

#SecondaryButton:hover {
    background-color: #f0f2f5;
    border-color: #b3bac3;
}

#SecondaryButton:disabled {
    color: #b3bac3;
    background-color: #f7f8fa;
}

#DangerButton {
    padding: 8px 14px;
    border: 1px solid #f0c2be;
    border-radius: 6px;
    background-color: #ffffff;
    color: #b4232c;
    font-size: 13px;
    font-weight: 500;
}

#DangerButton:hover {
    background-color: #fdeceb;
    border-color: #e39b95;
}

#DangerButton:disabled {
    color: #d9a9a5;
    border-color: #f0e0de;
    background-color: #f7f8fa;
}

/* ─── Transactions table ────────────────────────────────────────────────── */

#TransactionTable {
    background-color: #ffffff;
    alternate-background-color: #fbfcfd;
    border: 1px solid #e3e6ea;
    border-radius: 8px;
    gridline-color: transparent;
    selection-background-color: #eaf1fd;
    selection-color: #1c2024;
    outline: none;
}

#TransactionTable::item {
    padding: 9px 12px;
    border-bottom: 1px solid #f0f2f5;
}

#TransactionTable QHeaderView::section {
    padding: 10px 12px;
    border: none;
    border-bottom: 1px solid #e3e6ea;
    background-color: #ffffff;
    color: #6b7480;
    font-size: 12px;
    font-weight: 600;
}

#TransactionTable QHeaderView::section:hover {
    color: #1c2024;
}

/* ─── Empty states ──────────────────────────────────────────────────────── */

#EmptyState {
    background-color: #ffffff;
    border: 1px solid #e3e6ea;
    border-radius: 8px;
}

#EmptyTitle {
    font-size: 16px;
    font-weight: 600;
    color: #1c2024;
    background-color: transparent;
}

#EmptyMessage {
    font-size: 13px;
    color: #6b7480;
    background-color: transparent;
}

/* ─── Dialogs ───────────────────────────────────────────────────────────── */

#TransactionDialog {
    background-color: #ffffff;
}

#TransactionDialog QLabel {
    background-color: transparent;
}

/* ─── Scrollbars ────────────────────────────────────────────────────────── */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #cdd2d9;
    border-radius: 5px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #b3bac3;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    height: 0;
    background: none;
}
