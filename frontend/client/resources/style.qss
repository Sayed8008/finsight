/* FinSight — application stylesheet.
 *
 * A restrained, neutral palette. Colour is used to carry meaning (status,
 * selection) rather than for decoration, so that later on green/amber/red can
 * mean "healthy / warning / exceeded" without competing with the interface.
 */

/* ─── Base ──────────────────────────────────────────────────────────────── */

QWidget {
    background-color: #f7f8fa;
    color: #1c2024;
    font-family: "Inter", "Segoe UI", "Ubuntu", "DejaVu Sans", sans-serif;
    font-size: 14px;
}

#ContentArea {
    background-color: #f7f8fa;
}

/* ─── Sidebar ───────────────────────────────────────────────────────────── */

#Sidebar {
    background-color: #ffffff;
    border-right: 1px solid #e3e6ea;
}

#Wordmark {
    padding: 22px 20px 18px 20px;
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.2px;
    color: #0f1419;
    background-color: transparent;
}

#NavList {
    background-color: transparent;
    outline: none;
    padding: 4px 10px;
}

#NavList::item {
    padding: 10px 12px;
    margin: 1px 0;
    border-radius: 6px;
    color: #4a5259;
}

#NavList::item:hover {
    background-color: #f0f2f5;
    color: #1c2024;
}

#NavList::item:selected {
    background-color: #eaf1fd;
    color: #1a56c4;
    font-weight: 600;
}

/* ─── Backend status indicator ──────────────────────────────────────────── */

#SidebarStatus {
    padding: 12px 20px;
    font-size: 12px;
    border-top: 1px solid #e3e6ea;
    background-color: transparent;
    color: #6b7480;
}

#SidebarStatus[online="true"] {
    color: #1a7f4b;
}

#SidebarStatus[online="false"] {
    color: #b4232c;
}

/* ─── Placeholder / empty states ────────────────────────────────────────── */

#PlaceholderView {
    background-color: #f7f8fa;
}

#PlaceholderTitle {
    font-size: 20px;
    font-weight: 600;
    color: #1c2024;
    background-color: transparent;
}

/* Wrap width is set in placeholder.py — Qt stylesheets have no max-width. */
#PlaceholderMessage {
    font-size: 14px;
    color: #6b7480;
    background-color: transparent;
}

/* ─── Account panel ─────────────────────────────────────────────────────── */

#AccountPanel {
    border-top: 1px solid #e3e6ea;
    background-color: transparent;
}

#AccountName {
    font-size: 13px;
    font-weight: 600;
    color: #1c2024;
    background-color: transparent;
}

#AccountEmail {
    font-size: 12px;
    color: #6b7480;
    background-color: transparent;
}

/* Sign out is an action, so it looks like one. It used to be a bare blue
 * label sitting directly under the email, which read as a third line of
 * account text — nothing about it said it could be pressed. Given a border and
 * its own space, it is unmistakably a control, and unmistakably not the
 * primary one. */
#SignOutButton {
    padding: 8px 12px;
    border: 1px solid #cdd2d9;
    border-radius: 6px;
    background-color: #ffffff;
    color: #4a5259;
    font-size: 13px;
    font-weight: 600;
}

#SignOutButton:hover {
    background-color: #fdeceb;
    border-color: #e39b95;
    color: #b4232c;
}

#SignOutButton:pressed {
    background-color: #f9dedb;
}

/* ─── Authentication screen ─────────────────────────────────────────────── */

#AuthView {
    background-color: #f7f8fa;
}

#AuthCard {
    background-color: #ffffff;
    border: 1px solid #e3e6ea;
    border-radius: 10px;
}

#AuthTitle {
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.2px;
    color: #0f1419;
    background-color: transparent;
}

#AuthSubtitle {
    font-size: 13px;
    color: #6b7480;
    background-color: transparent;
}

#AuthSwitchRow {
    background-color: transparent;
}

#AuthSwitchPrompt {
    font-size: 13px;
    color: #6b7480;
    background-color: transparent;
}

/* ─── Form controls ─────────────────────────────────────────────────────── */

#FieldLabel {
    font-size: 13px;
    font-weight: 500;
    color: #4a5259;
    background-color: transparent;
}

#FieldInput {
    padding: 9px 11px;
    border: 1px solid #cdd2d9;
    border-radius: 6px;
    background-color: #ffffff;
    color: #1c2024;
    selection-background-color: #1a56c4;
    selection-color: #ffffff;
}

#FieldInput:focus {
    border-color: #1a56c4;
}

#FieldInput:disabled {
    background-color: #f0f2f5;
    color: #8b939c;
}

#PrimaryButton {
    padding: 10px 16px;
    border: none;
    border-radius: 6px;
    background-color: #1a56c4;
    color: #ffffff;
    font-size: 14px;
    font-weight: 600;
}

#PrimaryButton:hover {
    background-color: #164aa8;
}

#PrimaryButton:pressed {
    background-color: #133e8c;
}

#PrimaryButton:disabled {
    background-color: #a9bee6;
    color: #eef2fb;
}

#LinkButton {
    border: none;
    background: transparent;
    color: #1a56c4;
    font-size: 13px;
    font-weight: 600;
    padding: 0;
    text-align: left;
}

#LinkButton:hover {
    color: #133e8c;
}

/* ─── Inline messages ───────────────────────────────────────────────────── */

#MessageBanner {
    padding: 9px 11px;
    border-radius: 6px;
    font-size: 13px;
}

#MessageBanner[level="error"] {
    background-color: #fdeceb;
    border: 1px solid #f3c4c0;
    color: #9c1f19;
}

#MessageBanner[level="info"] {
    background-color: #eaf1fd;
    border: 1px solid #c3d6f6;
    color: #16428f;
}

/* ─── Section headings ──────────────────────────────────────────────────── */

#SectionTitle {
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.2px;
    color: #0f1419;
    background-color: transparent;
}

#SectionSubtitle,
#PagerLabel {
    font-size: 13px;
    color: #6b7480;
    background-color: transparent;
}

/* ─── Filter bar ────────────────────────────────────────────────────────── */

#FilterBar {
    background-color: #ffffff;
    border: 1px solid #e3e6ea;
    border-radius: 8px;
}

/* The container a LabelledWidget provides. Transparent by *id*, deliberately,
 * rather than with a descendant rule such as `#FilterBar QWidget`: a QPushButton
 * is a QWidget, so that rule would also match the buttons inside — and since
 * `#FilterBar QWidget` is more specific than `#PrimaryButton`, it would win and
 * paint the primary button in nothing at all (ADR-022). */
#FormRow {
    background-color: transparent;
}

/* Combo boxes and date editors. Kept visually identical to #FieldInput so a
 * form row does not look assembled from parts. */
#FieldSelect {
    padding: 8px 10px;
    border: 1px solid #cdd2d9;
    border-radius: 6px;
    background-color: #ffffff;
    color: #1c2024;
    min-height: 18px;
}

#FieldSelect:focus,
#FieldSelect:on {
    border-color: #1a56c4;
}

#FieldSelect::drop-down {
    border: none;
    width: 18px;
}

/* The arrow has to be drawn, or there is none. Qt switches a widget to
 * stylesheet rendering as soon as any rule matches it and then draws only what
 * the sheet describes — so styling the box and its drop-down area, but not the
 * arrow inside it, left every combo box and date field in the application
 * looking like a read-only text box. Found by rendering the category dialog
 * and noticing its "Kind" field did not look like a chooser (ADR-012); the
 * same defect was on every filter bar, in plain sight since Phase 4.
 *
 * An image rather than a stylesheet trick. The tempting version — a zero-sized
 * box with transparent side borders and one solid edge — is a *browser* CSS
 * technique; Qt clamps the sub-control and draws a small rectangle instead,
 * which was tried and looked worse than nothing. `%RESOURCES%` is substituted
 * when the sheet is loaded, since a stylesheet URL is otherwise resolved
 * against the working directory. */
#FieldSelect::down-arrow {
    image: url("%RESOURCES%/chevron-down.svg");
    width: 10px;
    height: 10px;
    margin-right: 7px;
}

#FieldSelect QAbstractItemView {
    border: 1px solid #cdd2d9;
    background-color: #ffffff;
    selection-background-color: #eaf1fd;
    selection-color: #1a56c4;
    outline: none;
}

/* ─── Buttons beyond the primary one ────────────────────────────────────── */

#SecondaryButton {
    padding: 8px 14px;
    border: 1px solid #cdd2d9;
    border-radius: 6px;
    background-color: #ffffff;
    color: #1c2024;
    font-size: 13px;
    font-weight: 500;
}

#SecondaryButton:hover {
    background-color: #f0f2f5;
    border-color: #b3bac3;
}

#SecondaryButton:disabled {
    color: #b3bac3;
    background-color: #f7f8fa;
}

#DangerButton {
    padding: 8px 14px;
    border: 1px solid #f0c2be;
    border-radius: 6px;
    background-color: #ffffff;
    color: #b4232c;
    font-size: 13px;
    font-weight: 500;
}

#DangerButton:hover {
    background-color: #fdeceb;
    border-color: #e39b95;
}

#DangerButton:disabled {
    color: #d9a9a5;
    border-color: #f0e0de;
    background-color: #f7f8fa;
}

/* ─── Transactions table ────────────────────────────────────────────────── */

#TransactionTable {
    background-color: #ffffff;
    alternate-background-color: #fbfcfd;
    border: 1px solid #e3e6ea;
    border-radius: 8px;
    gridline-color: transparent;
    selection-background-color: #eaf1fd;
    selection-color: #1c2024;
    outline: none;
}

#TransactionTable::item {
    padding: 9px 12px;
    border-bottom: 1px solid #f0f2f5;
}

#TransactionTable QHeaderView::section {
    padding: 10px 12px;
    border: none;
    border-bottom: 1px solid #e3e6ea;
    background-color: #ffffff;
    color: #6b7480;
    font-size: 12px;
    font-weight: 600;
}

#TransactionTable QHeaderView::section:hover {
    color: #1c2024;
}

/* ─── Empty states ──────────────────────────────────────────────────────── */

#EmptyState {
    background-color: #ffffff;
    border: 1px solid #e3e6ea;
    border-radius: 8px;
}

#EmptyTitle {
    font-size: 16px;
    font-weight: 600;
    color: #1c2024;
    background-color: transparent;
}

#EmptyMessage {
    font-size: 13px;
    color: #6b7480;
    background-color: transparent;
}

/* ─── Budgets ───────────────────────────────────────────────────────────── */

#CardScroll,
#CardHolder {
    background-color: transparent;
}

#BudgetCard {
    background-color: #ffffff;
    border: 1px solid #e3e6ea;
    border-left: 3px solid #cdd2d9;
    border-radius: 8px;
}

/* The left edge carries the status, so a card's state is readable before any
 * of its numbers are. */
#BudgetCard[status="healthy"]  { border-left-color: #1a7f4b; }
#BudgetCard[status="warning"]  { border-left-color: #d9782e; }
#BudgetCard[status="exceeded"] { border-left-color: #b4232c; }

/* Each label is made transparent by its own id. `#BudgetCard QWidget` would be
 * shorter and would also match the Edit and Delete buttons — outranking
 * `#SecondaryButton`, and painting them in nothing (ADR-022). It would also
 * fight the swatch, whose colour is set per category from the data. */
#BudgetCategory {
    font-size: 15px;
    font-weight: 600;
    color: #1c2024;
    background-color: transparent;
}

#BudgetPeriod {
    font-size: 12px;
    color: #6b7480;
    background-color: transparent;
}

#BudgetSpent {
    font-size: 13px;
    color: #4a5259;
    background-color: transparent;
}

#BudgetRemaining {
    font-size: 13px;
    font-weight: 600;
    color: #1c2024;
    background-color: transparent;
}

#BudgetPercentage {
    font-size: 13px;
    font-weight: 600;
    color: #6b7480;
    background-color: transparent;
    min-width: 62px;
    qproperty-alignment: 'AlignRight | AlignVCenter';
}

#BudgetRemaining[status="exceeded"],
#BudgetPercentage[status="exceeded"] {
    color: #b4232c;
}

#BudgetRemaining[status="warning"],
#BudgetPercentage[status="warning"] {
    color: #b8620f;
}

#BudgetBar {
    border: none;
    border-radius: 4px;
    background-color: #eef0f3;
}

#BudgetBar::chunk {
    border-radius: 4px;
    background-color: #1a7f4b;
}

#BudgetBar[status="warning"]::chunk  { background-color: #d9782e; }
#BudgetBar[status="exceeded"]::chunk { background-color: #b4232c; }

/* ─── Subscriptions ─────────────────────────────────────────────────────── */

#SubscriptionCard {
    background-color: #ffffff;
    border: 1px solid #e3e6ea;
    border-left: 3px solid #cdd2d9;
    border-radius: 8px;
}

/* The left edge carries the state, as on a budget card. "Overdue" is not a
 * stored status — it is an active subscription whose date has passed, which
 * means either a charge went unnoticed or the record needs updating. */
#SubscriptionCard[state="active"]    { border-left-color: #1a7f4b; }
#SubscriptionCard[state="overdue"]   { border-left-color: #b4232c; }
#SubscriptionCard[state="paused"]    { border-left-color: #d9782e; }
#SubscriptionCard[state="cancelled"] { border-left-color: #cdd2d9; }

#SubscriptionName {
    font-size: 15px;
    font-weight: 600;
    color: #1c2024;
    background-color: transparent;
}

#SubscriptionCost,
#SubscriptionCategory {
    font-size: 13px;
    color: #4a5259;
    background-color: transparent;
}

#SubscriptionCategory {
    color: #6b7480;
}

#SubscriptionRenewal {
    font-size: 13px;
    font-weight: 600;
    color: #4a5259;
    background-color: transparent;
}

#SubscriptionRenewal[state="overdue"] { color: #b4232c; }
#SubscriptionRenewal[state="paused"]  { color: #b8620f; }
#SubscriptionRenewal[state="cancelled"] { color: #8b939c; }

#SubscriptionBadge {
    font-size: 11px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 9px;
    background-color: #eef0f3;
    color: #6b7480;
}

#SubscriptionBadge[state="active"]    { background-color: #e6f4ec; color: #1a7f4b; }
#SubscriptionBadge[state="overdue"]   { background-color: #fdeceb; color: #b4232c; }
#SubscriptionBadge[state="paused"]    { background-color: #fdf0e3; color: #b8620f; }
#SubscriptionBadge[state="cancelled"] { background-color: #eef0f3; color: #8b939c; }

/* ─── Summary strip ─────────────────────────────────────────────────────── */

#SummaryStrip {
    background-color: #ffffff;
    border: 1px solid #e3e6ea;
    border-radius: 8px;
}

#SummaryCaption {
    font-size: 12px;
    color: #6b7480;
    background-color: transparent;
}

#SummaryValue {
    font-size: 17px;
    font-weight: 600;
    color: #1c2024;
    background-color: transparent;
}

#SummaryValue[status="exceeded"] {
    color: #b4232c;
}

/* ─── Check boxes ───────────────────────────────────────────────────────── */

/* The indicator has to be styled explicitly. Qt switches a widget to
 * stylesheet rendering as soon as *any* rule matches it, and then draws only
 * what the sheet describes — so styling just the label leaves a checkbox with
 * no box at all: clickable, checkable, and invisible. Found by rendering it
 * (ADR-012); a `::indicator` rule is the fix.
 *
 * Typed rather than by id so every checkbox added later works by default. */
QCheckBox {
    font-size: 13px;
    color: #4a5259;
    background-color: transparent;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #cdd2d9;
    border-radius: 4px;
    background-color: #ffffff;
}

QCheckBox::indicator:hover {
    border-color: #1a56c4;
}

/* A solid fill rather than a tick: a tick needs an image asset, and filled
 * versus empty is unambiguous on its own. */
QCheckBox::indicator:checked {
    background-color: #1a56c4;
    border-color: #1a56c4;
}

QCheckBox::indicator:disabled {
    background-color: #f0f2f5;
    border-color: #e3e6ea;
}

#FilterCheck {
    font-size: 13px;
    color: #4a5259;
    background-color: transparent;
}

/* ─── Dashboard ─────────────────────────────────────────────────────────── */

#DashboardScroll,
#DashboardPage,
#DashboardMiddle,
#TileRow,
#RecentList,
#RecentRow {
    background-color: transparent;
}

#DashboardPanel {
    background-color: #ffffff;
    border: 1px solid #e3e6ea;
    border-radius: 8px;
}

#PanelTitle {
    font-size: 14px;
    font-weight: 600;
    color: #1c2024;
    background-color: transparent;
}

/* ─── Stat tiles ────────────────────────────────────────────────────────── */

#StatTile,
#HeroTile {
    background-color: #ffffff;
    border: 1px solid #e3e6ea;
    border-radius: 8px;
}

#StatCaption {
    font-size: 12px;
    color: #6b7480;
    background-color: transparent;
}

#StatValue {
    font-size: 20px;
    font-weight: 600;
    color: #1c2024;
    background-color: transparent;
}

/* The lead figure is larger on purpose: a row of six equally loud numbers has
 * no lead, and the eye has nowhere to land. */
#HeroValue {
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -0.5px;
    color: #0f1419;
    background-color: transparent;
}

/* Tone is a status, never decoration — used only where the sign has meaning. */
#StatValue[tone="positive"],
#HeroValue[tone="positive"] { color: #1a7f4b; }
#StatValue[tone="negative"],
#HeroValue[tone="negative"] { color: #b4232c; }

#StatDetail {
    font-size: 12px;
    color: #8b939c;
    background-color: transparent;
}

/* ─── Recent activity ───────────────────────────────────────────────────── */

#RecentDescription {
    font-size: 13px;
    color: #1c2024;
    background-color: transparent;
}

#RecentMeta {
    font-size: 11px;
    color: #8b939c;
    background-color: transparent;
}

#RecentAmount {
    font-size: 13px;
    font-weight: 600;
    background-color: transparent;
}

/* The same pair the transactions table uses, so a colour means one thing
 * across the whole application. */
#RecentAmount[direction="income"]  { color: #1a7f4b; }
#RecentAmount[direction="expense"] { color: #b4232c; }

/* ─── Attention bar ─────────────────────────────────────────────────────── */

#AttentionBar {
    background-color: #ffffff;
    border: 1px solid #e3e6ea;
    border-left: 3px solid #cdd2d9;
    border-radius: 8px;
}

#AttentionBar[state="warning"] { border-left-color: #d9782e; }
#AttentionBar[state="calm"]    { border-left-color: #1a7f4b; }

#AttentionText {
    font-size: 13px;
    color: #1c2024;
    background-color: transparent;
}

/* ─── Charts ────────────────────────────────────────────────────────────── */

#SpendingChart,
#SpendingChartView,
#ChartEmptyState {
    background-color: transparent;
    border: none;
}

/* ─── Analytics ─────────────────────────────────────────────────────────── */

#TrendChart,
#TrendChartView,
#ChangeList,
#ChangeRow {
    background-color: transparent;
    border: none;
}

#ChangeName {
    font-size: 13px;
    color: #1c2024;
    background-color: transparent;
}

#ChangePrevious {
    font-size: 12px;
    color: #8b939c;
    background-color: transparent;
}

#ChangeCurrent {
    font-size: 13px;
    font-weight: 600;
    color: #1c2024;
    background-color: transparent;
    min-width: 110px;
    qproperty-alignment: 'AlignRight | AlignVCenter';
}

#ChangeMovement {
    font-size: 12px;
    font-weight: 600;
    color: #6b7480;
    background-color: transparent;
    min-width: 78px;
    qproperty-alignment: 'AlignRight | AlignVCenter';
}

/* Spending is the subject of this table, so a rise is the unwelcome
 * direction — the arrow says which way, the colour says whether that is
 * good news, and neither is left to carry the meaning alone. */
#ChangeMovement[tone="positive"] { color: #1a7f4b; }
#ChangeMovement[tone="negative"] { color: #b4232c; }

/* ─── Insights ──────────────────────────────────────────────────────────── */

#InsightList {
    background-color: transparent;
}

#InsightCard {
    background-color: #ffffff;
    border: 1px solid #e3e6ea;
    border-left: 3px solid #cdd2d9;
    border-radius: 8px;
}

/* The left edge carries severity, so a screenful is skimmable before a word
 * of it is read. The badge repeats it in text — severity is never colour
 * alone. */
#InsightCard[severity="critical"] { border-left-color: #b4232c; }
#InsightCard[severity="warning"]  { border-left-color: #d9782e; }
#InsightCard[severity="info"]     { border-left-color: #1a56c4; }
#InsightCard[severity="good"]     { border-left-color: #1a7f4b; }

#InsightTitle {
    font-size: 14px;
    font-weight: 600;
    color: #1c2024;
    background-color: transparent;
}

#InsightDetail {
    font-size: 13px;
    color: #4a5259;
    background-color: transparent;
}

#InsightBadge {
    font-size: 11px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 9px;
    background-color: #eef0f3;
    color: #6b7480;
}

#InsightBadge[severity="critical"] { background-color: #fdeceb; color: #b4232c; }
#InsightBadge[severity="warning"]  { background-color: #fdf0e3; color: #b8620f; }
#InsightBadge[severity="info"]     { background-color: #eaf1fd; color: #1a56c4; }
#InsightBadge[severity="good"]     { background-color: #e6f4ec; color: #1a7f4b; }

/* ─── Detection candidates ──────────────────────────────────────────────── */

#CandidateCard {
    background-color: #ffffff;
    border: 1px solid #e3e6ea;
    border-left: 3px solid #cdd2d9;
    border-radius: 8px;
}

/* Confidence on the edge, and in words on the badge — never colour alone. */
#CandidateCard[confidence="high"]   { border-left-color: #1a7f4b; }
#CandidateCard[confidence="medium"] { border-left-color: #d9782e; }
#CandidateCard[confidence="low"]    { border-left-color: #cdd2d9; }

#CandidateName {
    font-size: 14px;
    font-weight: 600;
    color: #1c2024;
    background-color: transparent;
}

#CandidateCost {
    font-size: 13px;
    font-weight: 600;
    color: #1c2024;
    background-color: transparent;
}

/* The evidence is the point of this screen, so it is not a footnote. */
#CandidateEvidence {
    font-size: 13px;
    color: #4a5259;
    background-color: transparent;
}

#CandidateSeen {
    font-size: 11px;
    color: #8b939c;
    background-color: transparent;
}

#CandidateBadge {
    font-size: 11px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 9px;
    background-color: #eef0f3;
    color: #6b7480;
}

#CandidateBadge[confidence="high"]   { background-color: #e6f4ec; color: #1a7f4b; }
#CandidateBadge[confidence="medium"] { background-color: #fdf0e3; color: #b8620f; }
#CandidateBadge[confidence="low"]    { background-color: #eef0f3; color: #6b7480; }

/* ─── Settings ──────────────────────────────────────────────────────────── */

#CategoryList {
    background-color: transparent;
}

#CategoryRow {
    background-color: transparent;
    border-bottom: 1px solid #f0f2f5;
}

#CategoryGroup {
    font-size: 12px;
    font-weight: 600;
    color: #6b7480;
    background-color: transparent;
    padding: 12px 0 4px 0;
}

#CategoryName {
    font-size: 14px;
    color: #1c2024;
    background-color: transparent;
}

/* A retired category is dimmed rather than hidden. Hiding it would make
 * restoring one impossible, and there is no delete to fall back on (ADR-020).
 * The badge repeats it in words — the dimming alone is not the signal. */
#CategoryName[retired="true"] {
    color: #8b939c;
}

#CategoryBadge {
    font-size: 11px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 9px;
    background-color: #eef0f3;
    color: #6b7480;
}

#SettingsCaption {
    font-size: 13px;
    color: #6b7480;
    background-color: transparent;
}

#SettingsValue {
    font-size: 13px;
    font-weight: 600;
    color: #1c2024;
    background-color: transparent;
}

#SettingsNote {
    font-size: 12px;
    color: #8b939c;
    background-color: transparent;
    padding-top: 6px;
}

/* A value the user cannot change, shown where a field would be. Styled like a
 * field's text but without a box, so it does not read as an input that has
 * stopped working. */
#FieldStatic {
    font-size: 14px;
    color: #4a5259;
    background-color: transparent;
    padding: 9px 0;
}

/* The colour picker in the category dialog. Only the *selected* swatch is
 * given a border, and the fill comes from the widget's own stylesheet because
 * the colour is data — no rule here can know which colour a swatch holds. */
#ColourSwatch {
    border: 2px solid transparent;
    border-radius: 13px;
}

#ColourSwatch:hover {
    border-color: #b3bac3;
}

#ColourSwatch:checked {
    border-color: #0f1419;
}

/* ─── Import report ─────────────────────────────────────────────────────── */

#ReportCard {
    background-color: #ffffff;
    border: 1px solid #e3e6ea;
    border-radius: 8px;
}

/* A blocker is the reason an import will not run, so it carries the same red
 * edge an exceeded budget does — one colour, one meaning, across the app. */
#BlockerCard {
    background-color: #fdeceb;
    border: 1px solid #f3c4c0;
    border-left: 3px solid #b4232c;
    border-radius: 8px;
}

#BlockerText {
    font-size: 13px;
    color: #9c1f19;
    background-color: transparent;
}

/* A report describing options that have since changed. Amber rather than red:
 * nothing is wrong, but the figures below it are no longer the ones that would
 * apply, and the largest number on the page must not go on looking current. */
#StaleCard {
    background-color: #fdf0e3;
    border: 1px solid #f0d6b4;
    border-left: 3px solid #d9782e;
    border-radius: 8px;
}

#StaleTitle {
    font-size: 13px;
    font-weight: 600;
    color: #b8620f;
    background-color: transparent;
}

#StaleText {
    font-size: 12px;
    color: #8a5314;
    background-color: transparent;
}

#ReportTitle {
    font-size: 14px;
    font-weight: 600;
    color: #1c2024;
    background-color: transparent;
}

#ReportLine {
    font-size: 13px;
    color: #4a5259;
    background-color: transparent;
}

#ReportMuted {
    font-size: 12px;
    color: #8b939c;
    background-color: transparent;
}

#ReportBadge {
    font-size: 11px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 9px;
    background-color: #eef0f3;
    color: #6b7480;
}

/* Settled means the import knows what to do with it. Unsettled is a decision
 * still waiting on the user, and is named in words as well as coloured. */
#ReportBadge[settled="true"]  { background-color: #e6f4ec; color: #1a7f4b; }
#ReportBadge[settled="false"] { background-color: #fdf0e3; color: #b8620f; }

#SampleHeader {
    font-size: 11px;
    font-weight: 600;
    color: #6b7480;
    background-color: transparent;
}

#SampleCell {
    font-size: 12px;
    color: #1c2024;
    background-color: transparent;
}

/* ─── Dialogs ───────────────────────────────────────────────────────────── */

#TransactionDialog,
#BudgetDialog,
#SubscriptionDialog,
#DetectionDialog,
#ImportDialog,
#CategoryDialog {
    background-color: #ffffff;
}

/* Scoped to QLabel, never QWidget: `#Dialog QWidget` also matches every button
 * inside and outranks `#PrimaryButton`, which paints it in nothing (ADR-022). */
#TransactionDialog QLabel,
#BudgetDialog QLabel,
#SubscriptionDialog QLabel,
#DetectionDialog QLabel,
#ImportDialog QLabel,
#CategoryDialog QLabel {
    background-color: transparent;
}

/* ─── Scrollbars ────────────────────────────────────────────────────────── */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #cdd2d9;
    border-radius: 5px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #b3bac3;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    height: 0;
    background: none;
}

/* ─── Savings journey ───────────────────────────────────────────────────── */

/* Badges follow the insight and subscription badge shape exactly — same
   radius, padding and weight — so a third pill on the same screen reads as
   the same kind of object rather than a new one. Only the palette differs,
   and each colour is one already in use. */
#SavingsBadge {
    font-size: 11px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 9px;
    background-color: #eef0f3;
    color: #6b7480;
}

#SavingsBadge[badge="personal_best"]   { background-color: #fdf0e3; color: #b8620f; }
#SavingsBadge[badge="consistent_saver"] { background-color: #e6f4ec; color: #1a7f4b; }
#SavingsBadge[badge="savings_streak"]  { background-color: #e6f4ec; color: #1a7f4b; }
#SavingsBadge[badge="strong_saver"]    { background-color: #eaf1fd; color: #1a56c4; }
#SavingsBadge[badge="improving"]       { background-color: #eaf1fd; color: #1a56c4; }

/* Both the stacked container and the view, exactly as the spending and trend
   charts do it. Styling only the view leaves the QStackedWidget around it
   painting the default background, which reads as a grey box inside the white
   panel — no other chart on the screen has one. */
#SavingsChart,
#SavingsChartView {
    background-color: transparent;
    border: none;
}

/* The reason each badge was awarded. Same muted treatment as the
   observations line below it — these are supporting text, not findings in
   their own right, and giving them weight would compete with the figures in
   the tiles above. */
#SavingsBadgeDetails {
    font-size: 12px;
    color: #6b7480;
    background-color: transparent;
}

#SavingsObservations {
    font-size: 12px;
    color: #6b7480;
    background-color: transparent;
}

#BadgeRow {
    background-color: transparent;
}

/* ─── Sidebar active indicator ──────────────────────────────────────────── */

/* A bar that travels between nav items. The selected item keeps its tinted
   background from #NavList::item:selected — this adds the edge marker that
   makes the movement visible, since Qt stylesheets cannot transition a
   background colour. */
#NavIndicator {
    background-color: #1a56c4;
    border-radius: 2px;
}

/* ─── Interaction feedback ──────────────────────────────────────────────── */

/* Qt's stylesheet engine has no `transition` property, so a hover or press
   state changes at once however it is written. Rather than drive a colour
   animation per button — a graphics effect on every control, for a change too
   fast to read as gradual anyway — every interactive control gets a complete
   set of states here, and the animation budget is spent where movement is
   actually visible: pages arriving, the sidebar indicator travelling, and
   charts drawing themselves.

   Each pressed colour is one step darker than its hover colour, so a press
   reads as "further in" rather than as a different button. */

#SecondaryButton:pressed {
    background-color: #e6e9ee;
    border-color: #b6bdc6;
}

#DangerButton:pressed {
    background-color: #f9dedb;
    border-color: #d98d86;
}

#LinkButton:pressed {
    color: #0f2f6b;
}

/* Combo boxes and date fields already highlight their border on focus; a
   pressed state on the drop-down completes the set. */
#FieldSelect:pressed {
    border-color: #1a56c4;
}

/* Cards the user can act on lift very slightly under the cursor. A border
   change rather than a shadow: Qt stylesheets cannot animate a shadow, and a
   static one under every card would flatten the page. */
#BudgetCard:hover,
#SubscriptionCard:hover,
#CandidateCard:hover {
    border-color: #b6bdc6;
}
