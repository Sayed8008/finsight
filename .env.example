# FinSight — environment template
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is git-ignored and must NEVER be committed.
# This file (.env.example) is committed and must NEVER contain real secrets.

# ─── Database ─────────────────────────────────────────────────────────────
# PyMySQL driver. MySQL 8.4 uses caching_sha2_password, which requires the
# `cryptography` package to be installed (it is in requirements).
DATABASE_URL=mysql+pymysql://finsight:CHANGE_ME@localhost:3306/finsight

# Separate database used by the test suite. Tests TRUNCATE data, so this must
# never point at the development or production database.
TEST_DATABASE_URL=mysql+pymysql://finsight:CHANGE_ME@localhost:3306/finsight_test

# ─── Security ─────────────────────────────────────────────────────────────
# Generate a fresh value with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_VALUE
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

# ─── API server ───────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000

# Comma-separated origins allowed by CORS. The desktop client does not need
# CORS, so keep this tight; widen only if a browser client is ever added.
CORS_ORIGINS=http://localhost:8000

# ─── Application ──────────────────────────────────────────────────────────
# DEBUG=true enables verbose errors and auto-reload. Never true in production.
DEBUG=true
LOG_LEVEL=INFO

# Default currency for new accounts (ISO 4217).
DEFAULT_CURRENCY=BDT

# ─── Desktop client ───────────────────────────────────────────────────────
# Base URL the PySide6 client uses to reach the backend.
FINSIGHT_API_BASE_URL=http://127.0.0.1:8000/api/v1
